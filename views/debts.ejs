<%- include('layout', { body: `
<style>
  /* Clean Debt Badge Styles */
  .debt-badge-low {
    background: #d1fae5;
    color: #065f46;
    font-weight: 600;
  }

  .debt-badge-medium {
    background: #fef3c7;
    color: #92400e;
    font-weight: 600;
  }

  .debt-badge-high {
    background: #fee2e2;
    color: #991b1b;
    font-weight: 600;
  }

  /* Clean Total Unpaid Card */
  .total-unpaid-card {
    border-top: 3px solid #ef4444;
  }
</style>

<div>
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-4xl sm:text-5xl font-bold text-glass mb-2">Debt Overview</h1>
    <p class="text-glass-muted text-base sm:text-lg font-medium">Outstanding payments from all users</p>
  </div>

  <!-- Total Unpaid Card -->
  <div class="glass-strong rounded-2xl p-8 sm:p-10 mb-8 total-unpaid-card">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div class="flex-1">
        <div class="text-xs font-bold text-glass-muted uppercase tracking-wider mb-2">Total Unpaid Amount</div>
        <div class="text-4xl sm:text-5xl font-bold text-glass" id="totalUnpaid">-</div>
        <div class="text-glass-muted text-sm mt-3">Across all outstanding orders</div>
      </div>
      <div class="text-6xl sm:text-7xl opacity-20">💸</div>
    </div>
  </div>

  <!-- Debts Table -->
  <div class="glass-strong rounded-2xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="px-6 py-4 text-left text-xs font-bold text-glass-muted uppercase tracking-wider">User</th>
            <th class="px-6 py-4 text-left text-xs font-bold text-glass-muted uppercase tracking-wider">Orders</th>
            <th class="px-6 py-4 text-left text-xs font-bold text-glass-muted uppercase tracking-wider">Total Debt</th>
          </tr>
        </thead>
        <tbody id="debtsTableBody">
          <!-- Loaded via JavaScript -->
        </tbody>
      </table>
      <div id="emptyState" class="hidden p-12 text-center">
        <div class="text-6xl mb-4">🎉</div>
        <div class="text-glass text-xl font-bold mb-2">Everyone has paid!</div>
        <div class="text-glass-muted text-sm">No outstanding debts at this time</div>
      </div>
    </div>
  </div>
</div>

<script>
  loadDebts();

  async function loadDebts() {
    try {
      const res = await fetch('/api/debts');
      const data = await res.json();

      // Update total
      document.getElementById('totalUnpaid').textContent = formatVND(data.totalUnpaid);

      // Update table
      const tbody = document.getElementById('debtsTableBody');
      const emptyState = document.getElementById('emptyState');

      if (data.debts.length === 0) {
        tbody.innerHTML = '';
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
        tbody.innerHTML = data.debts.map(debt => {
          // Color based on amount
          let badgeClass = 'debt-badge-low';
          let icon = '✓';
          if (debt.total_debt > 100000) {
            badgeClass = 'debt-badge-high';
            icon = '⚠️';
          } else if (debt.total_debt > 50000) {
            badgeClass = 'debt-badge-medium';
            icon = '⚡';
          }

          return \`
            <tr class="glass-table-row">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-glass">\${debt.user_name}</td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-glass">\${debt.order_count} orders</td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="\${badgeClass} px-3 py-1 text-xs rounded-full inline-flex items-center gap-1">
                  <span>\${icon}</span>
                  <span>\${formatVND(debt.total_debt)}</span>
                </span>
              </td>
            </tr>
          \`;
        }).join('');
      }
    } catch (err) {
      console.error('Error loading debts:', err);
    }
  }

  function formatVND(amount) {
    return new Intl.NumberFormat('vi-VN', {
      style: 'currency',
      currency: 'VND'
    }).format(amount);
  }
</script>
` }) %>
